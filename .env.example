NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
ADMIN_URL=http://localhost:5173
# Optional comma-separated extra origins allowed by CORS
CORS_ORIGINS=
MONGO_URI=mongodb+srv://<database-user>:<password>@<cluster-host>/<database-name>?retryWrites=true&w=majority
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=
# lax | strict | none. Defaults to none in production so a storefront on another domain (e.g. vercel.app) keeps its session.
COOKIE_SAMESITE=
LOG_LEVEL=info

# Razorpay (use rzp_test_ keys outside production). Webhook secret is required in production.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PAYMENT_RESERVATION_MINUTES=30

# Cloudinary (all three or none)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP email (optional; without it emails are skipped and a warning is logged)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Admin accounts are NOT configured here. Use: npm run admin:create -- --email you@example.com
